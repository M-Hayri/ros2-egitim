{
  "name": "Mavi Gölge ROS 2 Eğitimi (Jazzy)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "ros",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "remoteUser": "ubuntu",
  "containerEnv": {
    "DISPLAY": ":1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Masaüstü (noVNC)",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
